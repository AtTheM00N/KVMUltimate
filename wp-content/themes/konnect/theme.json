{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1600px"
    },
    "color": {
      "custom": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Black",
          "color": "#000000"
        },
        {
          "slug": "surface",
          "name": "Dark graphite",
          "color": "#3f3f41"
        },
        {
          "slug": "scarlet",
          "name": "Logo scarlet",
          "color": "#e51141"
        },
        {
          "slug": "action",
          "name": "Action red",
          "color": "#d5103c"
        },
        {
          "slug": "paper",
          "name": "White",
          "color": "#ffffff"
        },
        {
          "slug": "muted",
          "name": "Graphite",
          "color": "#58595b"
        },
        {
          "slug": "deep-red",
          "name": "Deep red",
          "color": "#a40c2e"
        },
        {
          "slug": "soft-grey",
          "name": "Soft grey",
          "color": "#c9cacc"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Clash Grotesk",
          "fontFamily": "\"Clash Grotesk\",sans-serif",
          "fontFace": [
            {
              "fontFamily": "Clash Grotesk",
              "fontStyle": "normal",
              "fontWeight": "200 700",
              "src": [
                "file:./assets/fonts/clash-grotesk.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "General Sans",
          "fontFamily": "\"General Sans\",sans-serif",
          "fontFace": [
            {
              "fontFamily": "General Sans",
              "fontStyle": "normal",
              "fontWeight": "200 700",
              "src": [
                "file:./assets/fonts/general-sans.woff2"
              ]
            }
          ]
        },
        {
          "slug": "wordmark",
          "name": "Bespoke Stencil",
          "fontFamily": "\"Bespoke Stencil\",sans-serif",
          "fontFace": [
            {
              "fontFamily": "Bespoke Stencil",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/bespoke-stencil.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "body",
          "size": "1.0625rem",
          "name": "Body"
        },
        {
          "slug": "large",
          "size": "clamp(1.5rem,3vw,2.5rem)",
          "name": "Large"
        },
        {
          "slug": "section",
          "size": "clamp(2.5rem,5.5vw,5rem)",
          "name": "Section"
        },
        {
          "slug": "hero",
          "size": "clamp(3rem,9vw,8.5rem)",
          "name": "Hero"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "s",
          "size": "1rem",
          "name": "Small"
        },
        {
          "slug": "m",
          "size": "2rem",
          "name": "Medium"
        },
        {
          "slug": "l",
          "size": "4rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "clamp(5rem,10vw,9rem)",
          "name": "Section"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ink",
      "text": "var:preset|color|paper"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "500",
          "lineHeight": "1.15",
          "letterSpacing": "-0.025em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|paper"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|action",
          "text": "var:preset|color|paper"
        },
        "border": {
          "radius": "2px"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "campaign",
      "title": "Campaign landing page",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
